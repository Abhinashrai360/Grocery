# --- Server ---
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# --- Database (do NOT add the db name, the app appends /greencart) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
SELLER_EMAIL=seller@example.com
SELLER_PASSWORD=change-me

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Checkout ---
# Tax added on top of the product total, in percent
TAX_PERCENT=2
# Optional: leave blank to hide "Online payment" and use Cash on Delivery only
# Razorpay Dashboard -> Account & Settings -> API Keys (use rzp_test_... keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: secret you set there (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
